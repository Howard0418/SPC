{
  "Urls": "http://localhost:5243",
  "AppEnvironment": "test",
  "DatabaseProvider": "SqlServer",
  "SeedDatabase": false,
  "ConnectionStrings": {
    "SqlServer": "Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "Auth": {
    "Enabled": false,
    "JwtKey": "REPLACE_WITH_A_SECURE_KEY_AT_LEAST_32_CHARACTERS",
    "PortalSsoKey": "USE_THE_SAME_32_CHARACTER_SECRET_AS_PMRPORTAL"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SmtpSettings": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "SenderEmail": "sender@example.com",
    "DefaultRecipientEmail": "recipient@example.com",
    "EnableSsl": true,
    "SaveToLocalDisk": false,
    "LocalDiskFolder": "EmailOutbox"
  },
  "AllowedHosts": "*"
}
