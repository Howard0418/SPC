{
  "PortalDirectory": { "ApiBaseUrl": "http://localhost:8091" },
  "Urls": "http://localhost:5243",
  "AppEnvironment": "test",
  "DatabaseProvider": "SqlServer",
  "SeedDatabase": false,
  "ConnectionStrings": { "SqlServer": "__SET_VIA_ENV__" },
  "Auth": { "Enabled": false, "JwtKey": "__SET_VIA_ENV__", "PortalSsoKey": "__SET_VIA_ENV__" },
  "Chameleon": {
    "FreshnessThresholdSeconds": 90,
    "Sources": [
      { "SourceId": "CHA-111", "DisplayName": "Chameleon 111 廠區", "BaseUrl": "http://172.16.111.10/api/v1", "Enabled": true },
      { "SourceId": "CHA-113", "DisplayName": "Chameleon 113 廠區", "BaseUrl": "http://172.16.113.10/api/v1", "Enabled": true }
    ]
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "SmtpSettings": {
    "Host": "YOUR_SMTP_HOST",
    "Port": 587,
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "__SET_VIA_ENV__",
    "SenderEmail": "sender@example.com",
    "DefaultRecipientEmail": "recipient@example.com",
    "EnableSsl": true,
    "SaveToLocalDisk": false,
    "LocalDiskFolder": "EmailOutbox"
  },
  "Calibration": { "DeliveryEnabled": false },
