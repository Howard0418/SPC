{
  "name": "mes-spc-web",
  "version": "0.1.85",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode testhost",
    "dev:test": "vite --mode testhost",
    "build": "npm run check:i18n && vite build",
    "build:test": "npm run check:i18n && vite build --mode testhost",
    "build:production": "npm run check:i18n && vite build --mode production",
    "preview": "vite preview",
    "verify:built-api": "node scripts/verify-built-api.mjs",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:i18n": "node --test tests/i18n-*.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "echarts": "^5.6.0",
    "lucide-vue-next": "^1.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "11.4.16",
    "vue-router": "^4.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
