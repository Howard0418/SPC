<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend\MesSpc.Api\MesSpc.Api.csproj" />
  </ItemGroup>

  <!-- Explicit local cross-repository baseline; no copied implementation or machine-specific path. -->
  <PropertyGroup Condition="'$(FormulaCompatibilityPortalSource)' != ''">
    <DefineConstants>$(DefineConstants);PORTAL_FORMULA_COMPATIBILITY</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(FormulaCompatibilityPortalSource)' != ''">
    <Compile Include="$(FormulaCompatibilityPortalSource)" Link="Compatibility/PortalExcelFormulaEvaluator.cs" />
  </ItemGroup>

</Project>
